OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none

# Optional: set all three from a dated official pricing check to calculate estimates.
# OPENAI_INPUT_COST_PER_1M=
# OPENAI_CACHED_INPUT_COST_PER_1M=
# OPENAI_OUTPUT_COST_PER_1M=

# Pilot safety limits.
PILOT_MAX_BATCH_ROWS=100
PILOT_MAX_TEXT_CHARS=4000
PILOT_MAX_SINGLE_ANALYSES_PER_SESSION=20

# Optional persistent pilot feedback (Supabase).
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_FEEDBACK_TABLE=pilot_feedback

# Local/admin export only. Never add a service-role key to a public app deployment.
# SUPABASE_SERVICE_ROLE_KEY=
